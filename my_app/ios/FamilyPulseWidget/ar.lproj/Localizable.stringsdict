<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>pulse.waiting %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>zero</key>
			<string>لا طلبات بانتظارك</string>
			<key>one</key>
			<string>طلب واحد بانتظارك</string>
			<key>two</key>
			<string>طلبان بانتظارك</string>
			<key>few</key>
			<string>%lld طلبات بانتظارك</string>
			<key>many</key>
			<string>%lld طلبًا بانتظارك</string>
			<key>other</key>
			<string>%lld طلب بانتظارك</string>
		</dict>
	</dict>
	<key>pulse.toReview %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>zero</key>
			<string>لا شيء للمراجعة</string>
			<key>one</key>
			<string>واحد للمراجعة</string>
			<key>two</key>
			<string>اثنان للمراجعة</string>
			<key>few</key>
			<string>%lld للمراجعة</string>
			<key>many</key>
			<string>%lld للمراجعة</string>
			<key>other</key>
			<string>%lld للمراجعة</string>
		</dict>
	</dict>
</dict>
</plist>
