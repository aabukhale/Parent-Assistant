<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pulse_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pulse_card_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/pulse_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pulse_title"
        android:textColor="@color/pulse_accent"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pulse_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/pulse_ink"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView android:id="@+id/pulse_child_1" style="@style/PulseChildRow" />
    <TextView android:id="@+id/pulse_child_2" style="@style/PulseChildRow" />
    <TextView android:id="@+id/pulse_child_3" style="@style/PulseChildRow" />

    <TextView
        android:id="@+id/pulse_more"
        style="@style/PulseChildRow"
        android:textColor="@color/pulse_ink_muted" />

    <!-- Spacer (FrameLayout: plain View isn't allowed in RemoteViews). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/pulse_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/pulse_ink_muted"
        android:textSize="11sp" />
</LinearLayout>
